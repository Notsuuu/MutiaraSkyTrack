# Auto detect text files and perform LF normalization
* text=auto

# Force LF for all source files (critical for Linux/WSL2 compatibility)
*.php text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.blade.php text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.env text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
Makefile text eol=lf

# Binary files - no conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.zip binary
*.gz binary
*.tar binary
*.xlsx binary
*.xls binary
*.pdf binary
